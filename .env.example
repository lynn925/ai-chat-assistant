# OpenAI 兼容 API 配置
# 任选一个 OpenAI 兼容服务（OpenAI 官方 / 阿里云千问 / DeepSeek / Moonshot 等）

# ===== 必填 =====
# API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选 =====
# 自定义 baseURL（留空走 OpenAI 官方；填了就用对应服务）
# 千问(DashScope 兼容模式): https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot: https://api.moonshot.cn/v1
OPENAI_BASE_URL=

# 模型名
# OpenAI 官方: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# 千问: qwen-turbo, qwen-plus, qwen-max
# DeepSeek: deepseek-chat
LLM_MODEL=qwen-turbo
